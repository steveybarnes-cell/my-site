<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Without this iOS shows a plain white screen from tap to first frame,
	     which on a cold start or straight after install is long enough to look
	     like the app has failed. Charcoal + the gable mark matches the loading
	     screen ContentView shows next, so the handoff is invisible. -->
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.myprojectgroup.mpgsiterecords</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>mpgsiterecords</string>
			</array>
		</dict>
	</array>
	<key>SupabasePublishableKey</key>
	<string>$(SUPABASE_PUBLISHABLE_KEY)</string>
	<key>SupabaseURL</key>
	<string>$(SUPABASE_URL)</string>
</dict>
</plist>
